#!/usr/bin/env bash
set -e

USER=team254
HOST=ec2.team254.com
APP=cheesy-mail

echo "Deploying $APP from Git master branch..."
echo
ssh $USER@$HOST "cd /opt/sites/$APP && git checkout -f && git pull --ff-only origin master && /usr/local/bin/go mod download && /usr/local/bin/go build && sudo -n /usr/bin/systemctl restart $APP.service"
echo
echo "Deployed $APP."
